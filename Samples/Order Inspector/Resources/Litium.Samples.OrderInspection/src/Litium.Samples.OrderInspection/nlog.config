<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true"
      internalLogLevel="Warn">

  <targets>
    <target name="solutionFile"
            xsi:type="File"
            fileName="${basedir}/logs/order-inspection.log"
            layout="${longdate}|${uppercase:${level}}|${logger}|${message}${onexception:inner=|${exception:format=tostring}}" />
  </targets>

  <rules>
    <logger name="Litium.Samples.OrderInspection*" minlevel="Trace" writeTo="solutionFile" final="true" />
    <logger name="*" minlevel="Off" final="true" />
  </rules>

</nlog>
